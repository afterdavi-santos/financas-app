# Modelo do .env da VPS. Copie para .env NA VPS e preencha.
# O .env real nunca vai para o git (ja esta no .gitignore).
#
#   cp .env.prod.example .env && nano .env

# Dominio que aponta para o IP da VPS. E com ele que o Caddy pede o certificado
# HTTPS — precisa estar resolvendo ANTES da primeira subida.
# Sem dominio proprio, um gratuito serve (DuckDNS, ou <ip-com-tracos>.nip.io).
DOMINIO=financas.exemplo.com
# Opcional: segundo dominio servido em paralelo, com certificado proprio.
# Deixe comentado para servir apenas o DOMINIO acima.
#DOMINIO_ALT=financas.hopto.org

# E-mail para o Let's Encrypt avisar sobre expiracao de certificado.
EMAIL_TLS=voce@exemplo.com

# Senha do Postgres. Gere uma forte e especifica desta maquina:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Chave de assinatura do JWT, 512 bits (o que o HS512 exige):
#   openssl rand -base64 64
# NAO reaproveite a da sua maquina nem a do Render.
JWT_SECRET=
